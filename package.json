{
  "name": "fukushima-machinaka-lab",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:network": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:pages": "node scripts/build-github-pages.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "sql:compile": "npx -y firebase-tools@15.28.2 dataconnect:compile",
    "sql:deploy": "npx -y firebase-tools@15.28.2 deploy --only dataconnect",
    "sql:seed": "npx -y firebase-tools@15.28.2 dataconnect:execute dataconnect/seed_data.gql"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "clsx": "^2.1.1",
    "firebase-admin": "14.3.0",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
