# Public application URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase project / Authentication client configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fukushima-machinaka-lab
NEXT_PUBLIC_FIREBASE_API_KEY=

# Firebase Admin service account (server only; never expose with NEXT_PUBLIC_)
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Keep OFF until Data Connect schema + connector are deployed and verified.
# Only set true after staging has passed real role/consent checks.
MAP_DATA_ENABLED=false

# Optional public MapTiler browser key; restrict referrer domains in the MapTiler dashboard.
# GSI works without this key.
NEXT_PUBLIC_MAPTILER_KEY=

# Optional authenticated E2E test accounts (never use production users)
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
